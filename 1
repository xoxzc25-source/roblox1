    local F = State.Freeze
    State.Freeze = nil
    UI.freeze.Visible = false
    freezeHighlight.Enabled = false
    freezeHighlight.Adornee = nil
    if F and F.part and F.part.Parent then
        F.part:SetAttribute("Frozen", nil)
        F.part.Anchored = false
    end
end

function Frz.action()
    local target
    if State.Drag and State.Drag.part then
        target = State.Drag.part
        Drag.endNow()
    else
        local hit = State.MouseHit
        if hit then
            local t = hit.Instance:GetAttribute("ConstructionType")
            if t == "Brick" then
                local mdl = hit.Instance.Parent
                target = mdl and mdl.PrimaryPart
            elseif t == "Board" then
                target = hit.Instance
            elseif t == "Furniture" then
                local mdl = hit.Instance:FindFirstAncestorOfClass("Model")
                target = mdl and mdl.PrimaryPart
            end
        end
    end
    if target then
        Frz.start(target)
        showHint("ЗАМОРОЖЕНО НА 10 СЕК: гвоздь/цемент/клей — и закрепится навсегда")
