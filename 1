local Frame = {}

function Frame.hover(hit)
    local adornee, col
    if not State.IsCutting and not State.GrinderActive and not State.IsDragging and hit then
        local ctype = hit.Instance:GetAttribute("ConstructionType")
        if State.Mode == "None" then
            if ctype == "Brick" or ctype == "Board" then
                local busy
                if ctype == "Brick" then
                    local mdl = hit.Instance.Parent
                    local mp = mdl and mdl.PrimaryPart
                    busy = mp and (mp:GetAttribute("Mounted") or mp:GetAttribute("Nailed") or mp:GetAttribute("Frozen"))
                    adornee = mdl
                else
                    busy = hit.Instance:GetAttribute("Mounted") or hit.Instance:GetAttribute("Nailed") or hit.Instance:GetAttribute("Frozen")
                    adornee = hit.Instance
                end
                if busy then adornee = nil end
                col = Color3.fromRGB(255, 255, 255)
            elseif ctype == "Door" then
                adornee = hit.Instance
                col = Color3.fromRGB(150, 220, 150)
            elseif ctype == "Furniture" then
                local mdl = hit.Instance:FindFirstAncestorOfClass("Model")
                local mp = mdl and mdl.PrimaryPart
                if not (mp and mp:GetAttribute("Frozen")) then
                    adornee = mdl
                    col = Color3.fromRGB(255, 255, 255)
                end
            end
        elseif State.Mode == "Cutter" and ctype == "Brick" then
            adornee = hit.Instance.Parent
            col = Color3.fromRGB(90, 200, 255)
        elseif State.Mode == "Grinder" and ctype == "Board" then
            adornee = hit.Instance
            col = Color3.fromRGB(255, 160, 60)
        elseif State.Mode == "Hammer" and (ctype == "Board" or ctype == "Brick" or ctype == "Furniture") then
            adornee = hit.Instance
            col = Color3.fromRGB(255, 230, 140)
        elseif State.Mode == "Sledge" and SMASHABLE[ctype] then
            adornee = hit.Instance
            col = Color3.fromRGB(255, 90, 70)
        elseif State.Mode == "C4" and ctype then
            adornee = hit.Instance
            col = Color3.fromRGB(255, 160, 40)
        elseif State.Mode == "Sponge" and PAINTABLE[ctype] then
            adornee = hit.Instance
            col = Color3.fromRGB(120, 200, 255)
        elseif State.Mode == "Rope" and ctype then
            adornee = hit.Instance
            col = Color3.fromRGB(200, 200, 255)
        end
    end
    State.HoveredPart = adornee and hit and hit.Instance or nil
    if adornee then
        showHighlight(adornee, col)
    else
        hideHighlight()
    end
end

function Frame.ghost(hit)
    local P = State.Place
    if P and P.ghost and P.ghost.Parent then
        if hit then
            local cf = CFrame.new(hit.Position) * CFrame.Angles(0, facingYaw(), 0)
            P.cf = cf
            P.ghost.CFrame = cf * CFrame.new(0, P.ghost.Size.Y / 2, 0)
            P.ghost.Transparency = 0.6
        else
            P.cf = nil
            P.ghost.Transparency = 1
        end
    end
end

function Frame.cutBand(dt)
    local cut = State.Cut
    if cut and cut.band and cut.band.Parent and cut.main and cut.main.Parent then
        cut.t += dt
        local amp = math.max(0.05, cut.main.Size.X / 2 - 0.18)
        cut.offset = math.sin(cut.t * 2.4) * amp
        cut.band.CFrame = cut.main.CFrame * CFrame.new(cut.offset, 0, 0)
    end
end

function Frame.grinder(dt, hit)
    local g = State.Grind
    if not g then return end
    local mloc = UserInputService:GetMouseLocation()
    local dy = mloc.Y - (g.lastMouseY or mloc.Y)
    g.lastMouseY = mloc.Y
    local onBoard = (hit and hit.Instance == g.board and g.board.Parent ~= nil) or false
    if onBoard then
        g.lastPoint = hit.Position
        g.normal = hit.Normal
        if State.Grinding and not g.cutOffset then
            local axis = g.board.CFrame.RightVector
            g.cutOffset = (hit.Position - g.board.Position):Dot(axis)
            g.cutLine = create("Part", {
                Size = Vector3.new(0.09, 0.06, g.board.Size.Z + 0.08),
                Color = Color3.fromRGB(30, 30, 30),
                Material = Enum.Material.SmoothPlastic,
                Transparency = 0.2,
                Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            }, Fol.fx)
        end
        if State.Grinding and g.cutOffset and dy > 0 then
            g.progress = math.min(g.progress + dy, g.needed)
            UI.progressFill.Size = UDim2.new(math.clamp(g.progress / g.needed, 0, 1), 0, 1, 0)
            if g.progress >= g.needed then
                Grind.complete()
                return
            end
        end
    end
    if g.model and g.model.Parent then
        g.yaw += (g.yawTarget - g.yaw) * math.min(dt * 10, 1)
        local up = g.normal or Vector3.new(0, 1, 0)
        local fwd = Vector3.new(math.cos(g.yaw), 0, math.sin(g.yaw))
        g.model:PivotTo(CFrame.lookAt(g.lastPoint + up * 0.05, g.lastPoint + up * 0.05 + fwd, up))
    end
    if g.cutLine and g.cutLine.Parent and g.board and g.board.Parent then
        g.cutLine.CFrame = g.board.CFrame * CFrame.new(g.cutOffset or 0, g.board.Size.Y / 2 + 0.04, 0)
    end
    if g.sparks then
        g.sparks.Enabled = State.Grinding and onBoard
    end
end

function Frame.toolPose(model, hit, lift, angle)
    if not (model and model.Parent and hit) then return end
    local pos, nrm = hit.Position, hit.Normal
    local P = pos + nrm * lift
    local camLook = camera.CFrame.LookVector
    local tangent = camLook - nrm * camLook:Dot(nrm)
    if tangent.Magnitude < 0.05 then
        tangent = surfaceTangent(nrm)
    else
        tangent = tangent.Unit
    end
    model:PivotTo(CFrame.lookAt(P, P + tangent, nrm) * CFrame.Angles(angle, 0, 0))
end

function Frame.hammer(dt, hit)
    local H = State.Hammer
    if not (H and H.model and H.model.Parent) then return end
    local S = State.HammerSwing
    if S then
        local done = Hmr.runSwing(H.model, S, 0.35, 0.95, -math.rad(78), dt, function()
            Hmr.nail(S.part, S.pos, S.normal)
        end)
        if done then State.HammerSwing = nil end
    else
        Frame.toolPose(H.model, hit, 0.95, -math.rad(78))
    end
end

function Frame.sledge(hit)
    local SL = State.Sledge
    if SL and SL.model and SL.model.Parent then
        Frame.toolPose(SL.model, hit, 1.25, -math.rad(105))
    end
end

function Frame.sponge(dt, hit)
    local SP = State.Sponge
    if not (SP and SP.model and SP.model.Parent) then return end
    Frame.toolPose(SP.model, hit, 1.1, 0)
    if State.Cleaning and hit then
        local removed = Spg.clean(hit.Position)
        if removed > 0 then
            local now = os.clock()
            if now - SP.lastSnd > 0.25 then
                SP.lastSnd = now
                playSound("rbxasset://sounds/impact_water.mp3", workspace, 0.4, 1 + math.random() * 0.3)
            end
        end
    end
end

function Frame.c4Held(hit)
    if State.C4Held and State.C4Held.Parent then
        if hit then
            State.C4Held.CFrame = CFrame.new(hit.Position + hit.Normal * 0.5) * CFrame.Angles(0, facingYaw(), 0)
            State.C4Held.Transparency = 0.3
        else
            local c = camera.CFrame
            State.C4Held.CFrame = CFrame.new(c.Position + c.LookVector * 6) * CFrame.Angles(0, facingYaw(), 0)
            State.C4Held.Transparency = 0.6
        end
    end
end

function Frame.wirePreview(hit)
    if (State.Mode == "Wire" or State.Mode == "Pipe") and State.NodeLast then
        local lp = State.LinePreview
        if not lp or not lp.Parent then
            lp = create("Part", {
                Size = Vector3.new(0.09, 0.09, 1),
                Color = Color3.fromRGB(90, 90, 100), Material = Enum.Material.SmoothPlastic,
                Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            }, Fol.fx)
            State.LinePreview = lp
        end
        local b = hit and hit.Position or (camera.CFrame.Position + camera.CFrame.LookVector * 10)
        local dist = (State.NodeLast - b).Magnitude
        if dist > 0.1 then
            lp.Size = Vector3.new(0.09, 0.09, dist)
            lp.CFrame = CFrame.lookAt((State.NodeLast + b) / 2, b)
        end
    elseif State.LinePreview and State.LinePreview.Parent then
        State.LinePreview:Destroy()
        State.LinePreview = nil
    end
end

function Frame.ropePreview(hit)
    if State.Mode == "Rope" and State.RopeSel then
        -- тонкая веревочная линия выбора (НЕ неон), видна только пока выбираешь второй объект
        local rp = State.RopePreview
        if not rp or not rp.Parent then
            rp = create("Part", {
                Size = Vector3.new(0.05, 0.05, 1),
                Color = Color3.fromRGB(150, 110, 80), Material = Enum.Material.SmoothPlastic,
                Transparency = 0.35,
                Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            }, Fol.fx)
            State.RopePreview = rp
        end
        local a = State.RopeSel.pos
        local bpos = hit and hit.Position or (camera.CFrame.Position + camera.CFrame.LookVector * 12)
        local dist = (a - bpos).Magnitude
        if dist > 0.1 then
            rp.Size = Vector3.new(0.05, 0.05, dist)
            rp.CFrame = CFrame.lookAt((a + bpos) / 2, bpos)
        end
    end
end

function Frame.adhPreview(hit)
    if (State.Mode == "Cement" or State.Mode == "Glue") and Adh.preview then
        local cfg = Adh.cfg[State.Mode]
        if hit then
            local fullH = cfg.visH / cfg.ratio
            local center = Adh.center(hit.Position, hit.Normal, cfg.visH, cfg.ratio)
            Adh.preview.Size = Vector3.new(cfg.width, fullH, 0.5)
            Adh.preview.Color = cfg.color
            Adh.preview.Material = cfg.material
            Adh.preview.CFrame = CFrame.lookAt(center, center + surfaceTangent(hit.Normal), hit.Normal)
            Adh.preview.Transparency = 0.5
        else
            Adh.preview.Transparency = 1
        end
    end
end

function Frame.roll(hit)
    local R = State.Roll
    if not (R and R.model and R.model.Parent) then return end
    local cfg = Roll.cfg[R.kind]
    if R.rollPart and R.rollPart.Parent then
        R.rollPart.Color = cfg.colorGet()
    end
    if R.strip and R.strip.Parent then
        R.strip.Color = cfg.colorGet()
    end
    local pos, nrm, fwd
    if State.Rolling and State.Stroke then
        nrm = State.Stroke.normal
        pos = State.Stroke.lastPos + nrm * (cfg.rollDiam / 2)
        local lp = State.Stroke.lastPos
        if R.lastPos then
            local dvec = lp - R.lastPos
            local flat = dvec - nrm * dvec:Dot(nrm)
            local m = flat.Magnitude
            if m > 0.02 then
                R.fwd = flat / m
                R.angle += m / (cfg.rollDiam / 2)
            end
        end
        R.lastPos = lp
        fwd = R.fwd
    else
        R.lastPos = nil
        R.fwd = nil
        R.angle = 0
        if hit then
            pos = hit.Position + hit.Normal * (cfg.rollDiam / 2 + 0.05)
            nrm = hit.Normal
        else
            local c = camera.CFrame
            pos = c.Position + c.LookVector * 6
            nrm = Vector3.new(0, 1, 0)
        end
        fwd = nil
    end
    local up = nrm
    local f = fwd or surfaceTangent(nrm)
    R.model:PivotTo(CFrame.lookAt(pos, pos + f, up) * CFrame.Angles(R.angle, 0, 0))
    if R.strip and R.strip.Parent then
        local sp = pos - up * (cfg.rollDiam / 2 + 0.3)
        R.strip.CFrame = CFrame.lookAt(sp, sp + f, up)
    end
end

function Frame.rollingStroke()
    if State.Rolling and State.Roll then
        local cfg = Roll.cfg[State.Roll.kind]
        StrokeF.process({
            folder = cfg.folder,
            validTypes = WALLABLE,
            width = cfg.width,
            thickness = cfg.thickness,
            spacing = cfg.spacing,
            overlap = cfg.overlap,
            cap = Limits.roll,
            ctype = cfg.ctype,
            colorFn = cfg.colorGet,
        })
    end
end

function Frame.painting()
    if State.IsPainting then
        local width = (State.PaintTool == "Roller") and 0.85 or 0.32
        StrokeF.processDab({
            folder = Fol.paint,
            validTypes = PAINTABLE,
            width = width,
            spacing = width * 0.42,
            cap = Limits.paint,
            colorFn = function()
                return State.PaintColor
            end,
        })
    end
end

function Frame.cementing(hit)
    if State.Cementing and (State.Mode == "Cement" or State.Mode == "Glue") and hit then
        local cfg = Adh.cfg[State.Mode]
        local n = hit.Normal
        if State.LastCementPos then
            local nChanged = (State.LastCementNrm and State.LastCementNrm:Dot(n) < 0.6) or false
            if nChanged then
                Adh.depositStart(cfg, hit.Position, n, hit.Instance)
                State.LastCementPos = hit.Position
                State.LastCementNrm = n
            elseif Adh.depositSegment(cfg, State.LastCementPos, hit.Position, n, hit.Instance) then
                State.LastCementPos = hit.Position
                State.LastCementNrm = n
            end
        else
            Adh.depositStart(cfg, hit.Position, n, hit.Instance)
            State.LastCementPos = hit.Position
            State.LastCementNrm = n
        end
        capFolder(cfg.folder, Limits.cement)
    end
end

function Frame.freezeTimer(dt)
    local F = State.Freeze
    if F then
        if not F.part or not F.part.Parent then
            Frz.endNow()
        else
            F.t -= dt
            if F.t <= 0 then
                Frz.endNow()
            else
                UI.freezeFill.Size = UDim2.new(F.t / 10, 0, 1, 0)
                UI.freezeLabel.Text = ("ЗАМОРОЗКА: %.1f"):format(F.t)
            end
        end
    end
end

