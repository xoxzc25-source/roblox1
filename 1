local MD = {}

function MD.adhesive(hit, mode)
    if mode == "Glue" and hit then
        local mdl = hit.Instance:FindFirstAncestorOfClass("Model")
        if mdl and Win.reg[mdl] and Win.reg[mdl].broken then
            Win.repair(mdl)
            return
        end
    end
    State.Cementing = true
    State.LastCementPos = nil
    State.LastCementNrm = nil
    if hit then
        Adh.depositStart(Adh.cfg[mode], hit.Position, hit.Normal, hit.Instance)
        State.LastCementPos = hit.Position
        State.LastCementNrm = hit.Normal
    end
end

function MD.cutter()
    if State.HoveredPart and State.HoveredPart:GetAttribute("ConstructionType") == "Brick" then
        Cut.enter(State.HoveredPart.Parent)
    end
end

function MD.grinder(hit)
    if State.HoveredPart and State.HoveredPart:GetAttribute("ConstructionType") == "Board" and hit then
        Grind.enter(State.HoveredPart, hit.Position, hit.Normal)
    end
end

function MD.hammer(hit)
    if hit then
        local t = hit.Instance:GetAttribute("ConstructionType")
        if t == "Board" or t == "Brick" or t == "Furniture" then
            State.HammerSwing = { t = 0, part = hit.Instance, pos = hit.Position, normal = hit.Normal, applied = false }
        end
    end
end

function MD.sledge(hit)
    if hit then
        local t = hit.Instance:GetAttribute("ConstructionType")
        if SMASHABLE[t] then
            Sld.destroy(hit.Instance, hit.Position)
        end
    end
end

function MD.wirepipe(hit, mode)
    if hit then
        if State.NodeLast then
            if mode == "Wire" then
                Wires.segment(State.NodeLast, hit.Position)
            else
                Wires.pipeSegment(State.NodeLast, hit.Position)
            end
        end
        State.NodeLast = hit.Position
    end
end

function MD.c4(hit)
    if hit and hit.Instance:IsA("BasePart") then
        local t = hit.Instance:GetAttribute("ConstructionType")
        if t == "C4" then
            local mdl = hit.Instance:FindFirstAncestorOfClass("Model")
            if mdl and Boom.reg[mdl] then
                Boom.detonate(mdl)
            end
        else
            Boom.makeC4(hit.Position, hit.Normal, hit.Instance)
        end
    end
end

function MD.rope(hit)
    if hit and hit.Instance:IsA("BasePart") and hit.Instance:GetAttribute("ConstructionType") then
        if not State.RopeSel then
            State.RopeSel = { part = hit.Instance, pos = hit.Position }
            showHint("ВЕРЕВКА: ТЕПЕРЬ ЛКМ ПО ВТОРОМУ ОБЪЕКТУ | ESC — ОТМЕНА")
        elseif State.RopeSel.part and State.RopeSel.part.Parent then
            local a = State.RopeSel
            -- удаляем линию-предпросмотр ДО создания веревки
            Rope.destroyPreview()
            if hit.Instance ~= a.part then
                local att0 = Instance.new("Attachment")
                att0.Parent = a.part
                att0.WorldPosition = a.pos
                local att1 = Instance.new("Attachment")
                att1.Parent = hit.Instance
                att1.WorldPosition = hit.Position
                local rope = Instance.new("RopeConstraint")
                rope.Attachment0 = att0
                rope.Attachment1 = att1
                rope.Length = math.max(1, (a.pos - hit.Position).Magnitude * 1.15)
                rope.Visible = true
                rope.Thickness = 0.12
                rope.Color = BrickColor.new("Reddish brown")
                rope.Parent = Fol.fx
                playSound("rbxasset://sounds/electronicpingshort.wav", rope, 0.4)
            end
            State.RopeSel = nil
            showHint("ВЕРЕВКА ЗАВЯЗАНА | следующий клик — новая веревка, ESC — выйти")
        end
    end
end

function MD.none(hit)
    if hit then
        local t = hit.Instance:GetAttribute("ConstructionType")
        if t == "Door" then
            local mdl = hit.Instance:FindFirstAncestorOfClass("Model")
            if mdl and Door.reg[mdl] then
                Door.toggle(mdl)
                return
            end
        end
    end
    if State.HoveredPart and hit then
        local t = State.HoveredPart:GetAttribute("ConstructionType")
        if t == "Brick" then
            local mdl = State.HoveredPart.Parent
            if mdl and mdl.PrimaryPart then
                Drag.start(mdl.PrimaryPart, hit.Position)
            end
        elseif t == "Board" then
            Drag.start(State.HoveredPart, hit.Position)
        elseif t == "Furniture" then
            local mdl = State.HoveredPart:FindFirstAncestorOfClass("Model")
            if mdl and mdl.PrimaryPart then
                Drag.start(mdl.PrimaryPart, hit.Position)
            end
        end
    end
end

local function onMouseDown()
    -- пересчитываем луч в момент нажатия (важно для телефона)
    local excludePart
    if State.Drag then
        local m = State.Drag.part:FindFirstAncestorOfClass("Model")
        excludePart = m or State.Drag.part
    end
    if State.Cut then excludePart = State.Cut.model end
    local hit = mouseRay(excludePart)
    State.MouseHit = hit

    if State.IsCutting then
        Cut.perform()
        return
    end
    if State.HammerSwing then
        return
    end
    if State.GrinderActive then
        State.Grinding = true
        return
    end
    local m = State.Mode
    if m == "Cement" or m == "Glue" then
        MD.adhesive(hit, m)
    elseif m == "Place" then
        local P = State.Place
        if P and P.cf then
            Plc.build(P.kind, P.cf)
        end
    elseif m == "Cutter" then
        MD.cutter()
    elseif m == "Grinder" then
        MD.grinder(hit)
    elseif m == "Hammer" then
        MD.hammer(hit)
    elseif m == "Sledge" then
        MD.sledge(hit)
    elseif m == "Wire" or m == "Pipe" then
        MD.wirepipe(hit, m)
    elseif m == "C4" then
        MD.c4(hit)
    elseif m == "Sponge" then
        State.Cleaning = true
    elseif m == "Rope" then
        MD.rope(hit)
    elseif m == "Wallpaper" or m == "Carpet" then
        if hit and WALLABLE[hit.Instance:GetAttribute("ConstructionType")] then
            State.Rolling = true
            State.Stroke = { instance = hit.Instance, normal = hit.Normal, lastPos = hit.Position }
        end
    elseif m == "Paint" then
        if hit and PAINTABLE[hit.Instance:GetAttribute("ConstructionType")] then
            State.IsPainting = true
            State.Stroke = { instance = hit.Instance, normal = hit.Normal, lastPos = hit.Position }
        end
    else
        MD.none(hit)
    end
end

local function onMouseUp()
    if State.IsDragging then Drag.endNow() end
    State.Cementing = false
    State.Grinding = false
    State.Rolling = false
    State.IsPainting = false
    State.Cleaning = false
    State.Stroke = nil
end

