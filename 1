local cameraTween = nil

local function focusCamera(targetPos, dist, height)
    camera.CameraType = Enum.CameraType.Scriptable
    local d = camera.CFrame.Position - targetPos
    d = Vector3.new(d.X, 0, d.Z)
    if d.Magnitude < 0.05 then
        d = Vector3.new(0, 0, -1)
    else
        d = d.Unit
    end
    local pos = targetPos - d * dist + Vector3.new(0, height, 0)
    if cameraTween then cameraTween:Cancel() end
    cameraTween = TweenService:Create(camera, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = CFrame.lookAt(pos, targetPos) })
    cameraTween:Play()
end

local function restoreCamera()
    if cameraTween then
        cameraTween:Cancel()
        cameraTween = nil
    end
    camera.CameraType = Enum.CameraType.Custom
end

