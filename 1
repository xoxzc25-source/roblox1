local StrokeF = {}

function StrokeF.strip(folder, a, b, normal, width, thickness, color, ctype, overlap)
    local dir = b - a
    local len = dir.Magnitude
    if len < 0.01 then return end
    dir = dir / len
    local mid = (a + b) / 2 + normal * (thickness / 2 + 0.015)
    local p = create("Part", {
        Size = Vector3.new(len + (overlap or 0.05), thickness, width),
        CFrame = CFrame.lookAt(mid, mid + dir, normal),
        Color = color, Material = Enum.Material.SmoothPlastic,
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
        TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
    }, folder)
    p:SetAttribute("ConstructionType", ctype)
    return p
end

function StrokeF.process(cfg)
    local hit = State.MouseHit
    local st = State.Stroke
    if not hit or not st then return end
    local ctype = hit.Instance:GetAttribute("ConstructionType")
    if not cfg.validTypes[ctype] then return end
    if st.instance ~= hit.Instance or st.normal:Dot(hit.Normal) < 0.8 then
        st.instance = hit.Instance
        st.normal = hit.Normal
        st.lastPos = hit.Position
        return
    end
    local delta = hit.Position - st.lastPos
    if delta.Magnitude < cfg.spacing then return end
    if math.abs(delta.Unit:Dot(st.normal)) > 0.92 then return end
    StrokeF.strip(cfg.folder, st.lastPos, hit.Position, st.normal, cfg.width, cfg.thickness, cfg.colorFn(), cfg.ctype, cfg.overlap)
    st.lastPos = hit.Position
    capFolder(cfg.folder, cfg.cap)
end

function StrokeF.dab(pos, normal, width, color)
    local t = 0.045
    local p = create("Part", {
        Size = Vector3.new(width, width, t),
        CFrame = CFrame.lookAt(pos + normal * (t / 2 + 0.008), pos + normal * 2, surfaceTangent(normal)),
        Color = color, Material = Enum.Material.SmoothPlastic,
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
        TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
    }, Fol.paint)
    makeSphereMesh(p)
    p:SetAttribute("ConstructionType", "Paint")
    return p
end

function StrokeF.processDab(cfg)
    local hit = State.MouseHit
    local st = State.Stroke
    if not hit or not st then return end
    local ctype = hit.Instance:GetAttribute("ConstructionType")
    if not cfg.validTypes[ctype] then return end
    if st.instance ~= hit.Instance or st.normal:Dot(hit.Normal) < 0.8 then
        st.instance = hit.Instance
        st.normal = hit.Normal
        st.lastPos = hit.Position
        StrokeF.dab(hit.Position, hit.Normal, cfg.width, cfg.colorFn())
        return
    end
    local delta = hit.Position - st.lastPos
    local dist = delta.Magnitude
    if dist < cfg.spacing then return end
    if math.abs(delta.Unit:Dot(st.normal)) > 0.92 then return end
    local steps = math.ceil(dist / cfg.spacing)
    for i = 1, steps do
        StrokeF.dab(st.lastPos:Lerp(hit.Position, i / steps), hit.Normal, cfg.width, cfg.colorFn())
    end
    st.lastPos = hit.Position
    capFolder(cfg.folder, cfg.cap)
end

