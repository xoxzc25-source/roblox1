local Drag = {}

function Drag.start(part, hitPos)
    if not part or not part.Parent then return end
    if part:GetAttribute("Mounted") or part:GetAttribute("Nailed") then return end
    if part.Anchored then return end
    State.IsDragging = true
    local dragDist = (hitPos - camera.CFrame.Position).Magnitude
    dragDist = math.clamp(dragDist, 4, 60)
    local cp = RaycastParams.new()
    cp.FilterType = Enum.RaycastFilterType.Exclude
    local ex = baseExcludeList()
    local mdl = part:FindFirstAncestorOfClass("Model")
    table.insert(ex, mdl or part)
    local char = player.Character
    if char then table.insert(ex, char) end
    cp.FilterDescendantsInstances = ex
    local look = part.CFrame.LookVector
    local yaw0 = math.atan2(-look.X, -look.Z)
    State.Drag = {
        part = part,
        grabOffset = part.Position - hitPos,
        dragDist = dragDist,
        clampParams = cp,
        targetYaw = yaw0, shownYaw = yaw0,
    }
    hideHighlight()
end

function Drag.endNow()
    local d = State.Drag
    State.IsDragging = false
    State.Drag = nil
    if d and d.part and d.part.Parent then
        d.part.AssemblyAngularVelocity = Vector3.zero
        d.part.AssemblyLinearVelocity = d.part.AssemblyLinearVelocity * 0.35
    end
end

function Drag.adjustHeight(delta)
    local d = State.Drag
    if d then
        d.dragDist = math.clamp(d.dragDist + delta, 3, 90)
    end
end

