        Color = Color3.fromRGB(48, 48, 52), Material = Enum.Material.SmoothPlastic,
        CanCollide = false, CanQuery = false, CanTouch = false, Anchored = true,
    }, model)
    local sparks = create("ParticleEmitter", {
        Texture = "rbxasset://textures/particles/sparkles_main.dds",
        Color = ColorSequence.new(Color3.fromRGB(255, 176, 64)),
        LightEmission = 1, LightInfluence = 0,
        Speed = NumberRange.new(5, 9),
        SpreadAngle = Vector2.new(45, 45),
        Lifetime = NumberRange.new(0.12, 0.3),
        Rate = 70,
        Size = NumberSequence.new(0.35),
        Enabled = false,
    }, disc)
    model.PrimaryPart = disc
    model.Parent = Fol.tool
    local dir = hitPos - camera.CFrame.Position
    local yaw0 = math.atan2(dir.Z, dir.X)
    State.Grind = {
        board = board, model = model, sparks = sparks,
        yaw = yaw0, yawTarget = yaw0,
        lastPoint = hitPos, normal = hitNormal,
        progress = 0, needed = 320,
        cutOffset = nil, cutLine = nil, lastMouseY = nil,
    }
    board.Anchored = true
    hideHighlight()
    focusCamera(hitPos, 8, 2)
    showProgress()
    showHint("БОЛГАРКА: ЗАЖМИ И ТЯНИ ВНИЗ | ESC — ВЫХОД")
end

function Grind.exit()
    if not State.GrinderActive then return end
    State.GrinderActive = false
    State.Grinding = false
    local g = State.Grind
    State.Grind = nil
    if g then
        if g.model and g.model.Parent then g.model:Destroy() end
        if g.cutLine and g.cutLine.Parent then g.cutLine:Destroy() end
        if g.board and g.board.Parent then g.board.Anchored = false end
    end
    restoreCamera()
    hideHint()
    hideProgress()
end

function Grind.complete()
    local g = State.Grind
    if not g then return end
    local board = g.board
    if board and board.Parent and g.cutOffset then
        local leftP, rightP = Cut.split(board, g.cutOffset)
        local keptP, scrapP, sign
        if leftP.Size.X >= rightP.Size.X then
            keptP, scrapP, sign = leftP, rightP, 1
        else
            keptP, scrapP, sign = rightP, leftP, -1
        end
        local axis = board.CFrame.RightVector
        board:Destroy()
        scrapP:SetAttribute("ConstructionType", "Scrap")
        scrapP.AssemblyLinearVelocity = axis * 1.8 * sign + Vector3.new(0, 1.8, 0)
        startScrapLifecycle(scrapP)
    end
    Grind.exit()
end

