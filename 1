function Hmr.nail(part, hitPos, normal)
    if not part or not part.Parent then return end
    if not part:GetAttribute("Nailed") then
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local ex = baseExcludeList()
        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl then table.insert(ex, mdl) else table.insert(ex, part) end
        local char = player.Character
        if char then table.insert(ex, char) end
        rp.FilterDescendantsInstances = ex
        local under = workspace:Raycast(hitPos + normal * 0.1, -normal * 3, rp)
        if under and under.Instance and under.Instance:IsA("BasePart") and under.Instance ~= part then
            create("WeldConstraint", { Part0 = part, Part1 = under.Instance }, part)
            part:SetAttribute("Nailed", true)
            part:SetAttribute("Mounted", true)
        end
    end
    local baseCF = CFrame.lookAt(hitPos, hitPos + normal, surfaceTangent(normal)) * CFrame.Angles(0, math.rad(90), 0)
    local nail = create("Part", {
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(0.5, 0.07, 0.07),
        CFrame = baseCF * CFrame.new(-0.13, 0, 0),
        Color = Color3.fromRGB(190, 192, 198), Material = Enum.Material.Metal,
        CanCollide = false, CanQuery = false, CanTouch = false, Massless = true,
    }, Fol.construction)
    nail:SetAttribute("ConstructionType", "Nail")
    local nailHead = create("Part", {
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(0.03, 0.16, 0.16),
        CFrame = baseCF * CFrame.new(0.14, 0, 0),
        Color = Color3.fromRGB(190, 192, 198), Material = Enum.Material.Metal,
        CanCollide = false, CanQuery = false, CanTouch = false, Massless = true,
    }, Fol.construction)
    nailHead:SetAttribute("ConstructionType", "Nail")
    create("WeldConstraint", { Part0 = part, Part1 = nail }, nail)
    create("WeldConstraint", { Part0 = part, Part1 = nailHead }, nailHead)
    playSound("rbxasset://sounds/snap.mp3", part, 0.7)
end

function Hmr.runSwing(model, swing, duration, lift, maxAngle, dt, applyFn)
    local pos, nrm = swing.pos, swing.normal
    local P = pos + nrm * lift
    local camLook = camera.CFrame.LookVector
    local tangent = camLook - nrm * camLook:Dot(nrm)
    if tangent.Magnitude < 0.05 then
        tangent = surfaceTangent(nrm)
    else
        tangent = tangent.Unit
    end
    local F = CFrame.lookAt(P, P + tangent, nrm)
    local theta = maxAngle
    swing.t += dt / duration
    if not swing.applied and swing.t >= 0.5 then
        swing.applied = true
        applyFn()
    end
    if swing.t >= 1 then
        model:PivotTo(F * CFrame.Angles(maxAngle * 0.35, 0, 0))
        return true
    elseif swing.t < 0.5 then
        local k = 1 - swing.t / 0.5
        theta = maxAngle * k * k
    else
        local k = (swing.t - 0.5) / 0.5
        local e = 1 - (1 - k) * (1 - k)
        theta = maxAngle * e
    end
    model:PivotTo(F * CFrame.Angles(theta, 0, 0))
    return false
end

function Hmr.activate()
    State.Hammer = { model = Hmr.make() }
end

function Hmr.exit()
    State.HammerSwing = nil
    if State.Hammer and State.Hammer.model and State.Hammer.model.Parent then
        State.Hammer.model:Destroy()
    end
    State.Hammer = nil
end

