local Boom = {}
Boom.reg = {}

function Boom.makeC4(pos, normal, surfacePart)
    local model = Instance.new("Model")
    local center = pos + normal * 0.1
    local cf = CFrame.lookAt(center, center + surfaceTangent(normal), normal)
    local body = create("Part", {
        Size = Vector3.new(0.55, 0.18, 0.4),
        CFrame = cf,
        Color = Color3.fromRGB(62, 72, 52), Material = Enum.Material.SmoothPlastic,
        CanCollide = false, CanQuery = true, CanTouch = false,
        TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
    }, model)
    body:SetAttribute("ConstructionType", "C4")
    local light = create("Part", {
        Shape = Enum.PartType.Ball, Size = Vector3.new(0.12, 0.12, 0.12),
        CFrame = cf * CFrame.new(0, 0.14, -0.1),
        Color = Color3.fromRGB(255, 60, 50), Material = Enum.Material.Neon,
        CanCollide = false, CanQuery = false, CanTouch = false, Massless = true,
    }, model)
    create("WeldConstraint", { Part0 = body, Part1 = light }, light)
    if surfacePart and surfacePart:IsA("BasePart") and not surfacePart.Anchored then
        body.Anchored = false
        body.Massless = true
        create("WeldConstraint", { Part0 = body, Part1 = surfacePart }, body)
    else
        body.Anchored = true
    end
    model.PrimaryPart = body
    model.Parent = Fol.construction
    Boom.reg[model] = body
    task.spawn(function()
        while model.Parent do
            light.Color = Color3.fromRGB(255, 60, 50)
            task.wait(0.3)
            if not model.Parent then break end
            light.Color = Color3.fromRGB(120, 20, 15)
            task.wait(0.3)
        end
    end)
    return model
end

function Boom.scrapPieces(part, n, impulse)
    local cf, size = part.CFrame, part.Size
    local axes = { { "X", size.X }, { "Y", size.Y }, { "Z", size.Z } }
    table.sort(axes, function(a, b) return a[2] > b[2] end)
    local axisName, w = axes[1][1], axes[1][2]
    if w < 0.4 then return end
    local prev = -w / 2
    for i = 1, n do
        local a = prev
        local b = (i < n) and (-w / 2 + (w / n) * i + (math.random() - 0.5) * w * 0.12) or (w / 2)
        if b - a < 0.12 then b = a + 0.12 end
        local width = b - a
        local center = (a + b) / 2
        local off, newSize
        if axisName == "X" then
            off = Vector3.new(center, 0, 0)
            newSize = Vector3.new(width, size.Y, size.Z)
        elseif axisName == "Y" then
            off = Vector3.new(0, center, 0)
            newSize = Vector3.new(size.X, width, size.Z)
        else
            off = Vector3.new(0, 0, center)
            newSize = Vector3.new(size.X, size.Y, width)
        end
        local p = create("Part", {
            Size = newSize,
            CFrame = cf * CFrame.new(off),
            Color = part.Color, Material = part.Material,
            TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
        }, Fol.construction)
        p:SetAttribute("ConstructionType", "Scrap")
        if impulse then
            p.AssemblyLinearVelocity = impulse
                + Vector3.new((math.random() - 0.5) * 6, 2 + math.random() * 3, (math.random() - 0.5) * 6)
        end
        if State.CleanupEnabled then
            scheduleScrapCleanup(p)
        end
        prev = b
    end
end

function Boom.smash(part, impulse)
    if not part or not part.Parent then return end
    local t = part:GetAttribute("ConstructionType")
    if not t then
        -- карта/земля взрывом не разрушается
        return
    end
    if t == "C4" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl then Boom.detonate(mdl) end
        return
    end
    if t == "Window" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl then Win.shatter(mdl) end
        return
    end
    if t == "Nail" then
        part:Destroy()
        return
    end
    if t == "Furniture" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        spawnDust(part.Position, part.Color)
        if mdl and mdl.Parent then mdl:Destroy() end
        playSound("rbxasset://sounds/collide.wav", workspace, 0.6, 1.1)
        return
    end
    local size = part.Size
    local longest = math.max(size.X, size.Y, size.Z)
    if t == "Brick" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        if longest > 0.5 then
            Boom.scrapPieces(part, 3, impulse)
        end
        if mdl and mdl.Parent then mdl:Destroy() end
        playSound("rbxasset://sounds/collide.wav", workspace, 0.6, 1.2)
        return
    end
    if t == "Door" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl and Door.reg[mdl] then
            Door.reg[mdl].broken = true
        end
        if longest > 0.5 then
            Boom.scrapPieces(part, 3, impulse)
        end
        if part.Parent then part:Destroy() end
        playSound("rbxasset://sounds/collide.wav", workspace, 0.6, 1.1)
        return
    end
    if longest <= 0.5 then
        part.CanCollide = false
        local tw = TweenService:Create(part, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = Vector3.new(0.05, 0.05, 0.05), Transparency = 1,
        })
        tw:Play()
        tw.Completed:Connect(function()
            if part.Parent then part:Destroy() end
        end)
        return
    end
    Boom.scrapPieces(part, math.random(2, 3), impulse)
    if part.Parent then part:Destroy() end
    playSound("rbxasset://sounds/collide.wav", workspace, 0.6, 1.1)
end

function Boom.explode(pos, radius, power)
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { Fol.fx, Fol.paint, Fol.wallpaper, Fol.carpet, Fol.tool }
    op.MaxParts = 120
    local parts = workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(radius * 2, radius * 2, radius * 2), op)
    local seen = {}
    for _, p in ipairs(parts) do
        if not seen[p] and p.Parent then
            seen[p] = true
            local d = (p.Position - pos).Magnitude
            if d < radius then
                if p.Parent == Fol.cement or p.Parent == Fol.glue then
                    p:Destroy()
                else
                    local dir = (p.Position - pos) + Vector3.new(0, radius * 0.35, 0)
                    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 1, 0) end
                    dir = dir.Unit
                    local falloff = 1 - d / radius
                    Boom.smash(p, dir * power * falloff + Vector3.new(0, 8 * falloff, 0))
                end
            end
        end
    end
    local flash = create("Part", {
        Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2),
        CFrame = CFrame.new(pos),
        Color = Color3.fromRGB(255, 200, 90), Material = Enum.Material.Neon,
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
        Transparency = 0.1,
    }, Fol.fx)
    TweenService:Create(flash, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(radius * 1.6, radius * 1.6, radius * 1.6),
        Transparency = 1,
    }):Play()
    Debris:AddItem(flash, 0.35)
    spawnDust(pos, Color3.fromRGB(160, 155, 145))
    playSound("rbxasset://sounds/collide.wav", workspace, 1, 0.55)
    playSound("rbxasset://sounds/flashbulb.wav", workspace, 0.8, 0.5)
end

function Boom.detonate(model)
    local body = Boom.reg[model]
    Boom.reg[model] = nil
    if not body or not body.Parent then return end
    local pos = body.Position
    model:Destroy()
    Boom.explode(pos, 9, 46)
end

