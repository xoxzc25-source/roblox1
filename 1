-- ================= ЖИЗНЕННЫЙ ЦИКЛ ОБРЕЗКОВ =================
local function startScrapLifecycle(part)
    local hl = create("Highlight", {
        FillColor = Color3.fromRGB(255, 210, 90),
        OutlineColor = Color3.fromRGB(255, 230, 140),
        FillTransparency = 0.45,
        Adornee = part,
    }, part)
    task.delay(2, function()
        if hl.Parent then
            TweenService:Create(hl, TweenInfo.new(1.6), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
        end
    end)
    task.delay(4, function()
        if hl.Parent then hl:Destroy() end
    end)
    task.delay(5, function()
        if part.Parent then
            part.CanCollide = false
            local tw = TweenService:Create(part, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = Vector3.new(0.05, 0.05, 0.05), Transparency = 0.5,
            })
            tw:Play()
            tw.Completed:Connect(function()
                if part.Parent then part:Destroy() end
            end)
        end
    end)
end

local function scheduleScrapCleanup(part)
    task.delay(10, function()
        if part.Parent then
            part.CanCollide = false
            local tw = TweenService:Create(part, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = Vector3.new(0.05, 0.05, 0.05), Transparency = 1,
            })
            tw:Play()
            tw.Completed:Connect(function()
                if part.Parent then part:Destroy() end
            end)
        end
    end)
end

