-- ================= RAYCAST =================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function baseExcludeList()
    return { Fol.fx, Fol.cement, Fol.glue, Fol.carpet, Fol.paint, Fol.wallpaper, Fol.wires, Fol.pipes, Fol.tool }
end

local function mouseRay(excludePart)
    local list = baseExcludeList()
    local char = player.Character
    if char then table.insert(list, char) end
    if excludePart then table.insert(list, excludePart) end
    rayParams.FilterDescendantsInstances = list
    local m = UserInputService:GetMouseLocation()
    local ray = camera:ViewportPointToRay(m.X, m.Y)
    return workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
end

