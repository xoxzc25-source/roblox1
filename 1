function Frz.start(part)
    if not part or not part.Parent then return end
    if part:GetAttribute("Mounted") or part:GetAttribute("Nailed") then return end
    if part.Anchored then return end
    local prev = State.Freeze
    if prev and prev.part and prev.part.Parent then
        prev.part:SetAttribute("Frozen", nil)
        prev.part.Anchored = false
    end
    part.Anchored = true
    part:SetAttribute("Frozen", true)
    part.AssemblyAngularVelocity = Vector3.zero
    part.AssemblyLinearVelocity = Vector3.zero
    State.Freeze = { part = part, t = 10 }
    freezeHighlight.Adornee = part:FindFirstAncestorOfClass("Model") or part
    freezeHighlight.Enabled = true
    UI.freeze.Visible = true
    UI.freezeFill.Size = UDim2.new(1, 0, 1, 0)
end

