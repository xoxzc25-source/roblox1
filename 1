        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl and Win.reg[mdl] then
            Win.reg[mdl].broken = true
            Win.reg[mdl].glass = nil
        end
        if part.Parent then part:Destroy() end
    elseif t == "Door" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl and Door.reg[mdl] then
            Door.reg[mdl].broken = true
        end
        if part.Parent then part:Destroy() end
    elseif t == "Furniture" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl and mdl.Parent then mdl:Destroy() end
    elseif t == "Brick" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl and mdl:GetAttribute("ConstructionType") == "Brick" then
            mdl:Destroy()
        elseif part.Parent then
