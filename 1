RunService.Heartbeat:Connect(function(dt)
    -- гасим бешеное вращение деталей
    for _, inst in ipairs(Fol.construction:GetChildren()) do
        local p
        if inst:IsA("BasePart") then
            p = inst
        elseif inst:IsA("Model") then
            p = inst.PrimaryPart
        end
        if p and p.Parent and not p.Anchored then
            local av = p.AssemblyAngularVelocity
            if av.Magnitude > 1.5 then
                p.AssemblyAngularVelocity = av.Unit * 1.5
            end
        end
    end

    -- переноска + вращение R (пока держишь)
    local d = State.Drag
    if d and d.part and d.part.Parent then
        if rHeld then
            d.targetYaw += dt * 3.0
        end
        local m = UserInputService:GetMouseLocation()
        local ray = camera:ViewportPointToRay(m.X, m.Y)
        local target = ray.Origin + ray.Direction * d.dragDist + d.grabOffset
        local below = workspace:Raycast(target + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), d.clampParams)
        if below then
            local minY = below.Position.Y + d.part.Size.Y / 2
            if target.Y < minY then
                target = Vector3.new(target.X, minY, target.Z)
            end
        end
        local vel = (target - d.part.Position) * 14
        if vel.Magnitude > 80 then
            vel = vel.Unit * 80
        end
        d.part.AssemblyLinearVelocity = vel
        d.shownYaw += (d.targetYaw - d.shownYaw) * math.min(dt * 12, 1)
        d.part.CFrame = CFrame.new(d.part.Position) * CFrame.Angles(0, d.shownYaw, 0)
        d.part.AssemblyAngularVelocity = Vector3.zero
    end

    -- скан закрепления + чистка реестров
    mountScanAcc += dt
    if mountScanAcc >= 0.3 then
        mountScanAcc = 0
        for m in pairs(Door.reg) do
            if not m.Parent then Door.reg[m] = nil end
        end
        for m in pairs(Win.reg) do
            if not m.Parent then Win.reg[m] = nil end
        end
        for m in pairs(Boom.reg) do
            if not m.Parent then Boom.reg[m] = nil end
        end
        for _, inst in ipairs(Fol.construction:GetDescendants()) do
            if inst:IsA("BasePart") and (not inst.Anchored or inst:GetAttribute("Frozen")) then
                local t = inst:GetAttribute("ConstructionType")
                if (t == "Brick" or t == "Board") and not inst:GetAttribute("Mounted") then
                    if inst.AssemblyLinearVelocity.Magnitude < 0.7
                        and inst.AssemblyAngularVelocity.Magnitude < 1.2 then
                        Mount.try(inst)
                    end
                end
            end
        end
    end
end)

