local Wires = {}

function Wires.segment(a, b)
    local dist = (b - a).Magnitude
    if dist < 0.3 then return end
    local mid = (a + b) / 2
    local ctrl = mid - Vector3.new(0, dist * 0.12, 0)
    local steps = math.clamp(math.ceil(dist / 0.6), 3, 60)
    local prev = a
    for i = 1, steps do
        local t = i / steps
        local p = (1 - t) * (1 - t) * a + 2 * (1 - t) * t * ctrl + t * t * b
        local segLen = (p - prev).Magnitude
        if segLen > 0.02 then
            create("Part", {
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(segLen + 0.02, 0.06, 0.06),
                CFrame = CFrame.lookAt((prev + p) / 2, p) * CFrame.Angles(0, math.rad(90), 0),
                Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.SmoothPlastic,
                Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            }, Fol.wires)
        end
        prev = p
    end
    create("Part", {
        Size = Vector3.new(0.3, 0.3, 0.3),
        CFrame = CFrame.new(a),
        Color = Color3.fromRGB(70, 70, 75), Material = Enum.Material.SmoothPlastic,
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
    }, Fol.wires)
    capFolder(Fol.wires, Limits.wire)
end

function Wires.pipeSegment(a, b)
    local dist = (b - a).Magnitude
    if dist < 0.3 then return end
    create("Part", {
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(dist + 0.05, 0.4, 0.4),
        CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0),
        Color = Color3.fromRGB(150, 152, 158), Material = Enum.Material.Metal,
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
    }, Fol.pipes)
    create("Part", {
        Shape = Enum.PartType.Ball, Size = Vector3.new(0.52, 0.52, 0.52),
        CFrame = CFrame.new(a),
        Color = Color3.fromRGB(120, 122, 128), Material = Enum.Material.Metal,
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
    }, Fol.pipes)
    capFolder(Fol.pipes, Limits.pipe)
end

