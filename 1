local function playSound(id, parent, volume, speed)
    if not parent then return end
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = volume or 0.5
    s.PlaybackSpeed = speed or 1
    s.Parent = parent
    s:Play()
    Debris:AddItem(s, 6)
end

local function capFolder(folder, maxN)
    local kids = folder:GetChildren()
    local excess = #kids - maxN
    if excess <= 0 then return end
    for i = 1, excess do
        if not kids[i]:GetAttribute("Hidden") then
            kids[i]:Destroy()
        end
    end
end

local function lighten(c, k)
    return Color3.new(
        math.min(c.R * k + 0.04, 1),
        math.min(c.G * k + 0.04, 1),
        math.min(c.B * k + 0.04, 1)
    )
end

local function surfaceTangent(n)
    local t = Vector3.new(0, 1, 0):Cross(n)
    if t.Magnitude < 0.05 then
        t = Vector3.new(1, 0, 0):Cross(n)
    end
    return t.Unit
end

local function makeSphereMesh(part)
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Parent = part
    return mesh
end

local function facingYaw()
    local look = camera.CFrame.LookVector
    return math.atan2(-look.X, -look.Z)
end

