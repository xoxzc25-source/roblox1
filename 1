function Sld.destroy(part, hitPos)
    if not part or not part.Parent then return end
    local t = part:GetAttribute("ConstructionType")
    if not t then
        -- обычная карта/земля/базплейт: разрушать НЕЛЬЗЯ
        spawnDust(hitPos or part.Position, part.Color)
        playSound("rbxasset://sounds/collide.wav", workspace, 0.3, 1.4)
        return
    end
    if t == "C4" then
        local mdl = part:FindFirstAncestorOfClass("Model")
        if mdl then Boom.detonate(mdl) end
        return
    end
    spawnDust(hitPos or part.Position, part.Color)
