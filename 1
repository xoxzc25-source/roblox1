local Cut = {}

function Cut.split(part, offsetLocalX)
    local cf = part.CFrame
    local size = part.Size
    local w = size.X
    local leftW = math.clamp(offsetLocalX + w / 2, 0.12, w - 0.12)
    local rightW = w - leftW
    local function makePiece(width, centerLocal)
        local p = create("Part", {
            Size = Vector3.new(width, size.Y, size.Z),
            CFrame = cf * CFrame.new(centerLocal, 0, 0),
            Color = part.Color, Material = part.Material,
            TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
        }, Fol.construction)
        p:SetAttribute("ConstructionType", part:GetAttribute("ConstructionType"))
        return p
    end
    return makePiece(leftW, -w / 2 + leftW / 2), makePiece(rightW, w / 2 - rightW / 2)
end

function Cut.enter(model)
    if not model or not model.PrimaryPart then return end
    local main = model.PrimaryPart
    State.IsCutting = true
    State.Cut = { model = model, main = main, t = 0, offset = 0, band = nil }
    main.Anchored = true
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Transparency = 0.55
        end
    end
    State.Cut.band = create("Part", {
        Name = "CutBand",
        Size = Vector3.new(0.07, main.Size.Y + 0.12, main.Size.Z + 0.12),
        Color = Color3.fromRGB(255, 80, 55),
        Material = Enum.Material.Neon,
        Transparency = 0.15,
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
    }, Fol.fx)
    hideHighlight()
    focusCamera(main.Position, 7, 1.6)
    showHint("РЕЗАК: ЛКМ — РЕЗ ПО ПОЛОСЕ | ESC — ОТМЕНА")
end

function Cut.exit()
    if not State.IsCutting then return end
    State.IsCutting = false
    local cut = State.Cut
    State.Cut = nil
    if cut then
        if cut.band and cut.band.Parent then cut.band:Destroy() end
        if cut.model and cut.model.Parent then
            for _, p in ipairs(cut.model:GetDescendants()) do
                if p:IsA("BasePart") then p.Transparency = 0 end
            end
            if cut.model.PrimaryPart then
                cut.model.PrimaryPart.Anchored = false
            end
        end
    end
    restoreCamera()
    hideHint()
end

function Cut.perform()
    local cut = State.Cut
    if not cut or not cut.main or not cut.main.Parent then
        Cut.exit()
        return
    end
    local main = cut.main
    local leftP, rightP = Cut.split(main, cut.offset or 0)
    local keptP, scrapP, sign
    if leftP.Size.X >= rightP.Size.X then
        keptP, scrapP, sign = leftP, rightP, 1
    else
        keptP, scrapP, sign = rightP, leftP, -1
    end
    local axis = main.CFrame.RightVector
    Fab.brick(keptP.CFrame, keptP.Size, keptP.Color)
    keptP:Destroy()
    cut.model:Destroy()
    if cut.band and cut.band.Parent then cut.band:Destroy() end
    State.Cut = nil
    State.IsCutting = false
    restoreCamera()
    hideHint()
    scrapP:SetAttribute("ConstructionType", "Scrap")
    scrapP.AssemblyLinearVelocity = axis * 2.4 * sign + Vector3.new(0, 2.5, 0)
    playSound("rbxasset://sounds/snap.mp3", scrapP, 0.7)
    startScrapLifecycle(scrapP)
end

