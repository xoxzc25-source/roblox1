function Adh.center(pos, normal, visH, ratio)
    local fullH = visH / ratio
    return pos - normal * (fullH / 2 - visH)
end

function Adh.tint(color)
    local f = 0.96 + math.random() * 0.07
    return Color3.new(
        math.min(color.R * f, 1),
        math.min(color.G * f, 1),
        math.min(color.B * f, 1)
    )
end

function Adh.placePiece(cfg, centerPos, tangent, normal, sx, sz, visH, surface)
    local fullH = visH / cfg.ratio
    local blob = create("Part", {
        Size = Vector3.new(sx, fullH, sz),
        CFrame = CFrame.lookAt(centerPos, centerPos + tangent, normal),
        Color = Adh.tint(cfg.color),
        Material = cfg.material,
        Anchored = true, CanCollide = false, CanQuery = true, CanTouch = false,
        TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
    }, cfg.folder)
    makeSphereMesh(blob)
    blob:SetAttribute("ConstructionType", cfg.type)
    blob:SetAttribute("VisH", visH)
    blob:SetAttribute("Ratio", cfg.ratio)
    if surface and surface:IsA("BasePart") and not surface.Anchored then
        blob.Anchored = false
        blob.Massless = true
        create("WeldConstraint", { Part0 = blob, Part1 = surface }, blob)
    end
    return blob
end

function Adh.depositStart(cfg, pos, normal, surface)
    local d = cfg.width + 0.05
    Adh.placePiece(cfg, Adh.center(pos, normal, cfg.visH, cfg.ratio), surfaceTangent(normal), normal, d, d, cfg.visH, surface)
end

function Adh.depositSegment(cfg, fromPos, toPos, normal, surface)
    local dir = toPos - fromPos
    local flat = dir - normal * dir:Dot(normal)
    local len = flat.Magnitude
    if len < cfg.minSeg then return false end
    flat = flat / len
    local mid = (fromPos + toPos) / 2
    local center = Adh.center(mid, normal, cfg.visH, cfg.ratio)
    Adh.placePiece(cfg, center, flat, normal, cfg.width + math.random() * 0.08, len + cfg.overlap, cfg.visH, surface)
    return true
end

function Adh.deform(blob, factor, pushDir, pushDist)
    local visH = blob:GetAttribute("VisH")
    local ratio = blob:GetAttribute("Ratio") or 0.45
    if not visH or not blob.Parent then return end
    local cf = blob.CFrame
    local n = cf.UpVector
    local sink = blob.Size.Y / 2 - visH
    local surfPos = blob.Position + n * sink
    local newVis = math.max(visH * factor, 0.02)
    local newFull = newVis / ratio
    local newSurf = surfPos
    if pushDir and pushDist then
        newSurf = surfPos + pushDir * pushDist
    end
    local newCenter = newSurf - n * (newFull / 2 - newVis)
    local size = blob.Size
    TweenService:Create(blob, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(size.X * 1.25, newFull, size.Z * 1.08),
        CFrame = CFrame.new(newCenter) * cf.Rotation,
    }):Play()
    blob:SetAttribute("VisH", newVis)
end

function Adh.activate(kind)
    State.LastCementPos = nil
    State.LastCementNrm = nil
    if Adh.preview then Adh.preview:Destroy() end
    local cfg = Adh.cfg[kind]
    Adh.preview = create("Part", {
        Size = Vector3.new(cfg.width, cfg.visH / cfg.ratio, 0.5),
        Color = cfg.color, Material = cfg.material,
        Transparency = 1, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
    }, Fol.fx)
    makeSphereMesh(Adh.preview)
end

function Adh.deactivate()
    State.Cementing = false
    State.LastCementPos = nil
    State.LastCementNrm = nil
    if Adh.preview then
        Adh.preview:Destroy()
        Adh.preview = nil
    end
end

-- ================= ЗАКРЕПЛЕНИЕ НА ЦЕМЕНТЕ/КЛЕЮ =================
local Mount = {}

function Mount.anchorWeld(part, bottomCF, sx, sz, ownerModel)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local exList = baseExcludeList()
    if ownerModel then table.insert(exList, ownerModel) else table.insert(exList, part) end
    local char = player.Character
    if char then table.insert(exList, char) end
    rp.FilterDescendantsInstances = exList
    local downDir = -bottomCF.UpVector * 2.6
    local probes = {
        Vector3.new(0, 0, 0),
        Vector3.new(sx * 0.3, 0, sz * 0.3),
        Vector3.new(-sx * 0.3, 0, sz * 0.3),
        Vector3.new(sx * 0.3, 0, -sz * 0.3),
        Vector3.new(-sx * 0.3, 0, -sz * 0.3),
    }
    for _, off in ipairs(probes) do
        local origin = bottomCF * off
        local hit = workspace:Raycast(origin, downDir, rp)
        if hit and hit.Instance and hit.Instance:IsA("BasePart") then
            create("WeldConstraint", { Part0 = part, Part1 = hit.Instance }, part)
            return true
        end
    end
    return false
end

function Mount.weldNeighbors(part, cf, sx, sy, sz, ownerModel, blobsAll)
    local opN = OverlapParams.new()
    opN.FilterType = Enum.RaycastFilterType.Include
    opN.FilterDescendantsInstances = { Fol.construction }
    opN.MaxParts = 40
    local nearParts = workspace:GetPartBoundsInBox(cf, Vector3.new(sx + 0.45, sy + 0.45, sz + 0.45), opN)
    local count = 0
    for _, np in ipairs(nearParts) do
        if np ~= part and np:IsA("BasePart") and np.Parent and count < 6 then
            local nm = np:FindFirstAncestorOfClass("Model")
            if not (ownerModel and nm == ownerModel) then
                local t = np:GetAttribute("ConstructionType")
                if t == "Brick" or t == "Board" or t == "Wall" or t == "Foundation" or t == "Ceiling" then
                    local ncf = np.CFrame
                    local hs = np.Size / 2 + Vector3.new(0.55, 0.55, 0.55)
                    for _, blob in ipairs(blobsAll) do
                        if blob.Parent then
                            local rel = ncf:PointToObjectSpace(blob.Position)
                            if math.abs(rel.X) <= hs.X and math.abs(rel.Y) <= hs.Y and math.abs(rel.Z) <= hs.Z then
                                create("WeldConstraint", { Part0 = part, Part1 = np }, part)
                                count += 1
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    return count
end

function Mount.deformBlobs(blobsAll, bottomCF, sx, sy, sz)
    local innerW, innerZ = sx / 2 - 0.08, sz / 2 - 0.08
    local touched = 0
    for _, blob in ipairs(blobsAll) do
        if blob.Parent and not blob:GetAttribute("Hidden") then
            local rel = bottomCF:PointToObjectSpace(blob.Position)
            local bsz = blob.Size
            if math.abs(rel.Y) <= sy / 2 + 0.5 then
                local centerInside = (math.abs(rel.X) <= innerW and math.abs(rel.Z) <= innerZ)
                local fitsFully = (math.abs(rel.X) + bsz.X / 2 <= innerW + 0.15)
                    and (math.abs(rel.Z) + bsz.Z / 2 <= innerZ + 0.15)
                local hDir = Vector3.new(rel.X, 0, rel.Z)
                local pushDir
                if hDir.Magnitude > 0.05 then
                    pushDir = bottomCF:VectorToWorldSpace(hDir.Unit)
                else
                    pushDir = surfaceTangent(bottomCF.UpVector)
                end
                if centerInside and fitsFully then
                    touched += 1
                    blob:SetAttribute("Hidden", true)
                    blob.CanQuery = false
                    Adh.deform(blob, 0.15, nil, 0)
                    TweenService:Create(blob, TweenInfo.new(0.18), { Transparency = 1 }):Play()
                elseif centerInside then
                    touched += 1
                    Adh.deform(blob, 0.3, pushDir, 0.22)
                elseif math.abs(rel.X) <= innerW + 0.6 and math.abs(rel.Z) <= innerZ + 0.6 then
                    touched += 1
                    Adh.deform(blob, 0.45, pushDir, 0.32)
                end
            end
        end
    end
    return touched
end

function Mount.try(part)
    if not part or not part.Parent then return end
    if part:GetAttribute("Mounted") then return end
    if State.Drag and State.Drag.part == part then return end
    if part.Anchored and not part:GetAttribute("Frozen") then return end
    local ctype = part:GetAttribute("ConstructionType")
    if ctype ~= "Brick" and ctype ~= "Board" then return end

    local cf = part.CFrame
    local sx, sy, sz = part.Size.X, part.Size.Y, part.Size.Z
    local bottomCF = cf * CFrame.new(0, -sy / 2, 0)
    local ownerModel = part:FindFirstAncestorOfClass("Model")

    local opAll = OverlapParams.new()
    opAll.FilterType = Enum.RaycastFilterType.Include
    opAll.FilterDescendantsInstances = { Fol.cement, Fol.glue }
    opAll.MaxParts = 100
    local blobsAll = workspace:GetPartBoundsInBox(cf, Vector3.new(sx + 0.6, sy + 0.6, sz + 0.6), opAll)
    if #blobsAll == 0 then return end

    local welded = Mount.anchorWeld(part, bottomCF, sx, sz, ownerModel)
    local nbCount = Mount.weldNeighbors(part, cf, sx, sy, sz, ownerModel, blobsAll)
    welded = welded or (nbCount > 0)
    if not welded then return end

    part:SetAttribute("Mounted", true)
    part.AssemblyAngularVelocity = Vector3.zero
    part.AssemblyLinearVelocity = Vector3.zero

    local touched = Mount.deformBlobs(blobsAll, bottomCF, sx, sy, sz)
    if touched > 0 then
        playSound("rbxasset://sounds/snap.mp3", part, 0.3)
    end
end

